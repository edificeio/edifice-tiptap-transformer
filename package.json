{
  "name": "rich-content-transformer",
  "version": "1.0.24-develop-pedago.6",
  "description": "Uses TipTap library to transform HTML to JSON and back",
  "license": "ISC",
  "author": "OpenDigitalEducation",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
    "format": "pnpm run format:write && pnpm run format:check",
    "format:check": "prettier --check 'src/**/*.ts'",
    "format:write": "prettier --write 'src/**/*.ts'",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "fix": "eslint src --fix --ext ts --report-unused-disable-directives --max-warnings 0",
    "pre-commit": "pnpm lint && pnpm format",
    "prepare": "husky install || true",
    "start": "node dist/index.js",
    "test": "vitest run test/unit test/integration",
    "test:watch": "vitest",
    "test:smoke": "vitest run test/smoke",
    "test:golden:capture": "tsx scripts/capture-golden.ts",
    "test:docker": "docker compose run --rm node sh -c \"pnpm i --frozen-lockfile && pnpm test\"",
    "test:integration:docker": "./scripts/run-integration-docker-tests.sh",
    "test:ci": "pnpm run test:docker && pnpm run test:integration:docker"
  },
  "dependencies": {
    "@edifice.io/tiptap-extensions": "chore-tiptap-v3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-blockquote": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-bullet-list": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-dropcursor": "3.31.4",
    "@tiptap/extension-font-family": "3.31.4",
    "@tiptap/extension-gapcursor": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-history": "3.31.4",
    "@tiptap/extension-horizontal-rule": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list-item": "3.31.4",
    "@tiptap/extension-ordered-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-strike": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/html": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/jsonwebtoken": "^9.0.9",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "6.19.1",
    "@typescript-eslint/parser": "6.19.1",
    "concurrently": "^8.2.2",
    "eslint": "8.56.0",
    "husky": "^8.0.3",
    "nodemon": "^3.1.10",
    "prettier": "3.2.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "turbo": "1.11.3",
    "typescript": "5.3.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@8.6.6",
  "engines": {
    "node": "16 || 18"
  }
}
